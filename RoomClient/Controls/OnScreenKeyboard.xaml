<UserControl x:Class="RoomClient.Controls.OnScreenKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WideKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}">
            <Setter Property="Width" Value="70"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Row 1: Q W E R T Y U I O P -->
        <StackPanel x:Name="Row1" Orientation="Horizontal" HorizontalAlignment="Center"/>

        <!-- Row 2: A S D F G H J K L (sedikit indent) -->
        <StackPanel x:Name="Row2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,0,0,0"/>

        <!-- Row 3: Z X C V B N M -->
        <StackPanel x:Name="Row3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="40,0,0,0"/>

        <!-- Row 4: Space, Backspace, Clear -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Button Content="Space" Style="{StaticResource WideKeyButtonStyle}" Width="180" Click="Space_Click"/>
            <Button Content="⌫" Style="{StaticResource WideKeyButtonStyle}" Click="Backspace_Click"/>
            <Button Content="Clear" Style="{StaticResource WideKeyButtonStyle}" Click="Clear_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>