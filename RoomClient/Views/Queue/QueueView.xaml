<UserControl x:Class="RoomClient.Views.Queue.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RoomClient.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="350">

    <UserControl.Resources>
        <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,8">

            <TextBlock DockPanel.Dock="Left"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="Queue"/>

            <Button x:Name="ToggleButton"
                    DockPanel.Dock="Right"
                    Margin="0,0,10,0"
                    Padding="10,6"
                    Background="#FF1E293B"
                    Foreground="White"
                    Click="OnToggleClick"/>

            <TextBlock DockPanel.Dock="Right"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#FF94A3B8"
                       Text="{Binding Queue.Items.Count,
                                      StringFormat={}{0} songs waiting}"/>

        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1"
              x:Name="ContentGrid">

            <!-- Empty State -->
            <Border Padding="16"
                    Background="#FF111827"
                    CornerRadius="14"
                    Visibility="{Binding Queue.Items.Count,
                                         Converter={StaticResource CountToVisibilityConverter}}">

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#FF64748B"
                           Text="Belum ada lagu dalam antrian."/>

            </Border>

            <!-- Queue -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Queue.Items}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,0,10"
                                    Padding="14"
                                    Background="#FF111827"
                                    CornerRadius="14">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Song Info -->
                                    <StackPanel Grid.Column="0">

                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="{Binding Song.Title}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock FontSize="11"
                                                   Foreground="#FF94A3B8"
                                                   Text="{Binding Song.Artist}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock FontSize="10"
                                                       Foreground="#FF64748B"
                                                       Text="Requested by "/>

                                            <TextBlock FontSize="10"
                                                       Foreground="#FF64748B"
                                                       Text="{Binding RequestedBy}"/>

                                            <TextBlock Margin="8,0,0,0"
                                                       FontSize="10"
                                                       Foreground="#FF64748B"
                                                       Text="{Binding RequestedAt,
                                                                      StringFormat={}{0:HH:mm}}"/>

                                        </StackPanel>

                                    </StackPanel>

                                    <!-- Remove -->
                                    <Button Grid.Column="1"
                                            Margin="10,0"
                                            Padding="12,6"
                                            Background="#FF7F1D1D"
                                            Foreground="White"
                                            Content="Remove"
                                            Command="{Binding DataContext.Queue.RemoveCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Play -->
                                    <Button Grid.Column="2"
                                            Padding="14,6"
                                            Background="#FF2563EB"
                                            Foreground="White"
                                            Content="Play"
                                            Command="{Binding DataContext.Queue.PlayCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>

</UserControl>