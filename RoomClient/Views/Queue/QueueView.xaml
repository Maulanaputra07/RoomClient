<UserControl x:Class="RoomClient.Views.Queue.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RoomClient.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="350">

    <UserControl.Resources>
        <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Antrean"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#FF94A3B8"
                       Margin="10, 0, 0, 0"
                       Text="{Binding Queue.Items.Count, StringFormat={}{0} Lagu menunggu}"/>
        </DockPanel>

        <!-- Content -->
        <Grid x:Name="ContentGrid" Grid.Row="1">

            <!-- Empty State -->
            <TextBlock Text="Belum ada lagu dalam antrian."
                       Foreground="#FF64748B"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="20,20,0,20"
                       Visibility="{Binding Queue.Items.Count, Converter={StaticResource CountToVisibilityConverter}}" />

            <!-- Queue Items -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Queue.Items}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Padding="14"
                                    Background="#FF111827"
                                    CornerRadius="14"
                                    HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0" Grid.Column="0" Width="36" Height="36" Background="#FF1D4ED8" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="YT" />
                                            <Image Source="{Binding Song.Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Detail Lagu & Peminta -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="{Binding Song.Title}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#FF94A3B8"
                                                   Text="{Binding Song.Artist}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Baris Tombol Action (Full Width) -->
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Tombol Remove -->
                                        <Button Grid.Column="0"
                                                Padding="0,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="#FF7F1D1D"
                                                Foreground="White"
                                                Content="Hapus"
                                                Command="{Binding DataContext.Queue.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>

                                        <!-- Tombol Play -->
                                        <Button Grid.Column="2"
                                                Padding="0,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="#FF2563EB"
                                                Foreground="White"
                                                Content="Play"
                                                Command="{Binding DataContext.Queue.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>