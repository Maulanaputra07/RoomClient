<ui:FluentWindow
    x:Class="RoomClient.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:header="clr-namespace:RoomClient.Views.Header"
    xmlns:player="clr-namespace:RoomClient.Views.Player"
    xmlns:queue="clr-namespace:RoomClient.Views.Queue"
    xmlns:search="clr-namespace:RoomClient.Views.Search"
    xmlns:songList="clr-namespace:RoomClient.Views.SongList"
    xmlns:status="clr-namespace:RoomClient.Views.Status"
    xmlns:register="clr-namespace:RoomClient.Views.Register"
    mc:Ignorable="d"
    Title="Room Client - Karaoke Room"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown">

    <Grid Background="#FF08111F"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">

        <Grid x:Name="MainContentGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Margin="12,12,12,10"
                    Padding="12"
                    Background="#FF0F172A"
                    CornerRadius="16">
                <header:HeaderView/>
            </Border>

            <!-- Main Content: Player (kiri) + Sidebar tab SongList/Queue (kanan, bisa ditutup) -->
            <Grid Grid.Row="1"
                  Margin="12,0,12,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SidebarColumnDefinition" Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Player (full width & height, kolom kiri) -->
                <Grid Grid.Column="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <!-- Default Margin saat ada lagu diputar -->
                            <Setter Property="Margin" Value="0,0,10,90"/>
                            <Style.Triggers>
                                <!-- Jika NowPlaying kosong/null, hilangkan margin bottom -->
                                <DataTrigger Binding="{Binding Player.NowPlaying}" Value="Tidak ada lagu yang diputar">
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Player.NowPlaying}" Value="{x:Null}">
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border x:Name="PlayerContainer"
            Background="#FF0F172A"
            CornerRadius="16">
                        <player:PlayerView x:Name="PlayerViewControl"/>
                    </Border>

                    <!-- Tombol buka kembali sidebar, muncul saat sidebar ditutup -->
                    <Button x:Name="OpenSidebarButton"
            Content="&#xE8A0;"
            FontFamily="Segoe MDL2 Assets"
            FontSize="14"
            Width="36" Height="36"
            Padding="0"
            Background="#E60F172A"
            Foreground="White"
            BorderThickness="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,0,16,16"
            Visibility="Collapsed"
            Click="OpenSidebarButton_Click"
            ToolTip="Tampilkan song list &amp; queue"/>

                </Grid>

                <!-- Sidebar: SongList / Queue dalam satu panel dengan toggle -->
                <Border x:Name="SidebarContainer"
                        Grid.Column="1"
                        Background="#FF0F172A"
                        CornerRadius="16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toggle SongList/Queue + tombol Close -->
                        <Grid Grid.Row="0" Margin="10,10,10,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal">

                                <ToggleButton x:Name="SongListTabButton"
                                              Content="Hasil Pencarian"
                                              IsChecked="True"
                                              Padding="12,6"
                                              Margin="0,0,6,0"
                                              Background="#FF1E293B"
                                              Foreground="White"
                                              BorderThickness="0"
                                              Click="SongListTabButton_Click"/>

                                <ToggleButton x:Name="QueueTabButton"
                                              Content="Antrean"
                                              IsChecked="False"
                                              Padding="12,6"
                                              Background="Transparent"
                                              Foreground="White"
                                              BorderThickness="0"
                                              Click="QueueTabButton_Click"/>

                            </StackPanel>

                            <Button x:Name="CloseSidebarButton"
                                    Grid.Column="1"
                                    Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Width="28" Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    Foreground="#FF94A3B8"
                                    BorderThickness="0"
                                    Click="CloseSidebarButton_Click"
                                    ToolTip="Sembunyikan panel, webview fullscreen"/>

                        </Grid>

                        <!-- Konten: hanya salah satu yang Visible sesuai tab aktif -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">

                            <songList:SongListView
                                x:Name="SongListView"
                                Visibility="Visible"/>

                            <queue:QueueView
                                x:Name="QueueView"
                                Visibility="Collapsed"/>

                        </Grid>

                    </Grid>

                </Border>

                <!--
                StatusView dan SearchView disembunyikan sementara.
                Kalau mau dikembalikan, tinggal buka komentar blok di bawah
                dan sesuaikan lagi struktur kolom/row-nya.

                <Border Padding="12" Background="#FF0F172A" CornerRadius="16">
                    <status:StatusView/>
                </Border>
                <Border Background="#FF0F172A" CornerRadius="16">
                    <search:SearchView/>
                </Border>
                -->

            </Grid>

        </Grid>

        <Border x:Name="PlayerFullScreenHost"
                Background="#FF08111F"
                Visibility="Collapsed"
                Panel.ZIndex="50"
                MouseMove="PlayerFullScreenHost_MouseMove">
            <Grid>
                <!-- WebView2 di-reparent ke sini saat fullscreen -->
                <ContentControl x:Name="PlayerFullScreenContent"/>

                <!-- Floating "Now Playing" bar, muncul saat mouse bergerak -->
                <Border x:Name="NowPlayingOverlay"
                        VerticalAlignment="Bottom"
                        Margin="32"
                        Padding="20,14"
                        Background="#E60F172A"
                        CornerRadius="16"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="Black" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Now Playing" FontSize="11" Foreground="#FF94A3B8"/>
                            <TextBlock Text="{Binding Player.NowPlaying}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="24,0,0,0">
                            <Button x:Name="PrevButton" Content="⏮"
                                    Width="40" Height="40" Margin="0,0,8,0"
                                    Command="{Binding Player.PreviousCommand}"/>
                            <Button x:Name="PlayPauseButton" Content="⏸"
                                    Width="48" Height="48" Margin="0,0,8,0"
                                    Command="{Binding Player.PlayPauseCommand}"/>
                            <Button x:Name="NextButton" Content="⏭"
                                    Width="40" Height="40" Margin="0,0,8,0"
                                    Command="{Binding Player.NextCommand}"/>
                            <Button x:Name="ExitFullScreenButton" Content="Exit"
                                    Padding="12,8" Margin="16,0,0,0"
                                    Click="ExitFullScreenButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Floating Bottom Player Bar: current song + prev/pause/next + fullscreen CTA -->
        <Border x:Name="BottomPlayerBar"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,28"
            Padding="20,12"
            Background="#E60F172A"
            CornerRadius="16"
            Panel.ZIndex="40">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Sembunyikan jika RegisterOverlay aktif -->
                        <DataTrigger Binding="{Binding ElementName=RegisterOverlay, Path=Visibility}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <!-- Sembunyikan jika NowPlaying kosong atau null -->
                        <DataTrigger Binding="{Binding Player.NowPlaying}" Value="Tidak ada lagu yang diputar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Player.NowPlaying}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">

                <!-- Current Song -->
                <StackPanel VerticalAlignment="Center"
                            MaxWidth="220"
                            Margin="0,0,20,0">
                    <TextBlock Text="Sedang Memutar"
                               FontSize="11"
                               Foreground="#FF94A3B8"/>
                    <TextBlock Text="{Binding Player.NowPlaying}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Transport Controls: dibind langsung ke ICommand di PlayerViewModel -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Button x:Name="BottomBarPrevButton"
                            Content="&#xE892;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Width="36" Height="36"
                            Margin="0,0,6,0"
                            Padding="0"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding Player.PreviousCommand}"
                            ToolTip="Previous"/>
                    <Button x:Name="BottomBarPlayPauseButton"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Width="44" Height="44"
                            Margin="0,0,6,0"
                            Padding="0"
                            Background="#FF1E293B"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding Player.PlayPauseCommand}"
                            ToolTip="Play/Pause">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="&#xE768;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Player.IsPlaying}" Value="True">
                                        <Setter Property="Content" Value="&#xE769;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BottomBarNextButton"
                            Content="&#xE893;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Width="36" Height="36"
                            Padding="0"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding Player.NextCommand}"
                            ToolTip="Next"/>
                </StackPanel>

                <!-- Fullscreen CTA: tetap lewat code-behind, konsisten dgn ExitFullScreenButton -->
                <Button x:Name="BottomBarFullScreenButton"
                        Content="&#xE740;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Width="36" Height="36"
                        Padding="0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Click="BottomBarFullScreenButton_Click"
                        ToolTip="Fullscreen webview"/>

            </StackPanel>
        </Border>

        <!-- Register Overlay -->
        <register:RegisterView
            x:Name="RegisterOverlay"
            Panel.ZIndex="100"
            Visibility="Collapsed"/>

    </Grid>

</ui:FluentWindow>
