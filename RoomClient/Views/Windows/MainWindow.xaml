<ui:FluentWindow
    x:Class="RoomClient.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:header="clr-namespace:RoomClient.Views.Header"
    xmlns:player="clr-namespace:RoomClient.Views.Player"
    xmlns:queue="clr-namespace:RoomClient.Views.Queue"
    xmlns:search="clr-namespace:RoomClient.Views.Search"
    xmlns:songList="clr-namespace:RoomClient.Views.SongList"
    xmlns:status="clr-namespace:RoomClient.Views.Status"
    mc:Ignorable="d"
    Title="Room Client - Karaoke Room"
    WindowStyle="None"
    WindowState="Maximized"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="#FF08111F" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="12,12,12,10"
            Padding="12"
            Background="#FF0F172A"
            CornerRadius="16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">
            <header:HeaderView />
        </Border>

        <Grid Grid.Row="1" Margin="12,0,12,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition x:Name="SongListRow" Height="220" />
                <RowDefinition x:Name="QueueRow" Height="*" />
            </Grid.RowDefinitions>


            <Grid Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,10,0" Background="#FF0F172A" CornerRadius="16">
                    <player:PlayerView />
                </Border>

                <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,10" Background="#FF0F172A" CornerRadius="16" Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <status:StatusView />
                    </Border>

                    <Border Grid.Row="1" Background="#FF0F172A" CornerRadius="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <search:SearchView />
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="SongListContainer" Grid.Row="1" Margin="0,0,0,10" Background="#FF0F172A" CornerRadius="16">
                <songList:SongListView x:Name="SongListView"/>
            </Border>

            <Border x:Name="QueueContainer" Grid.Row="2" Background="#FF0F172A" CornerRadius="16">
                <queue:QueueView x:Name="QueueView"/>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>