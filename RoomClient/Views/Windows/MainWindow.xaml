<ui:FluentWindow
    x:Class="RoomClient.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:header="clr-namespace:RoomClient.Views.Header"
    xmlns:player="clr-namespace:RoomClient.Views.Player"
    xmlns:queue="clr-namespace:RoomClient.Views.Queue"
    xmlns:search="clr-namespace:RoomClient.Views.Search"
    xmlns:songList="clr-namespace:RoomClient.Views.SongList"
    xmlns:status="clr-namespace:RoomClient.Views.Status"
    xmlns:register="clr-namespace:RoomClient.Views.Register"
    mc:Ignorable="d"
    Title="Room Client - Karaoke Room"
    WindowStyle="None"
    WindowState="Maximized"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Loaded="OnLoaded"
    PreviewKeyDown="OnPreviewKeyDown">

    <Grid Background="#FF08111F"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">

        <Grid x:Name="MainContentGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Margin="12,12,12,10"
                    Padding="12"
                    Background="#FF0F172A"
                    CornerRadius="16">
                <header:HeaderView/>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1"
                  Margin="12,0,12,12">

                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="1.25*"/>
                </Grid.RowDefinitions>

                <!-- Player + Status/Search -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Margin="0,0,10,0"
                            Background="#FF0F172A"
                            CornerRadius="16">
                        <player:PlayerView/>
                    </Border>

                    <Grid Grid.Column="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,10"
                                Padding="12"
                                Background="#FF0F172A"
                                CornerRadius="16">
                            <status:StatusView/>
                        </Border>

                        <Border Grid.Row="1"
                                Background="#FF0F172A"
                                CornerRadius="16">
                            <search:SearchView/>
                        </Border>

                    </Grid>

                </Grid>

                <!-- Song List + Queue -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Song List -->
                    <Border x:Name="SongListContainer"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Background="#FF0F172A"
                            CornerRadius="16">

                        <songList:SongListView
                            x:Name="SongListView"/>

                    </Border>

                    <!-- Queue -->
                    <Border x:Name="QueueContainer"
                            Grid.Column="1"
                            Background="#FF0F172A"
                            CornerRadius="16">

                        <queue:QueueView
                            x:Name="QueueView"/>

                    </Border>

                </Grid>

            </Grid>

        </Grid>

        <!-- Register Overlay -->
        <register:RegisterView
            x:Name="RegisterOverlay"
            Visibility="Collapsed"/>

    </Grid>

</ui:FluentWindow>