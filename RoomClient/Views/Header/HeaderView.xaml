<UserControl x:Class="RoomClient.Views.Header.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:RoomClient.Controls"
             xmlns:helpers="clr-namespace:RoomClient.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <helpers:BoolToSessionStatusBrushConverter x:Key="StatusBrushConverter" />
        <helpers:BoolToSessionStatusTextConverter x:Key="StatusTextConverter" />
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="#0F172A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Logo & Title -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0">
            <Border Width="48" Height="48" Background="#2563EB" CornerRadius="14">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="R" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" Text="Room Client" />
                <TextBlock FontSize="13" Foreground="#94A3B8" Text="Karaoke room control panel" />
            </StackPanel>
        </StackPanel>

        <!-- Search Area -->
        <!-- Search Area -->
        <StackPanel Grid.Column="1"
            VerticalAlignment="Center"
            MaxWidth="520"
            Margin="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Input Text -->
                <TextBox x:Name="SearchTextBox"
                 Grid.Column="0"
                 Height="38"
                 Padding="14,8"
                 Background="#1E293B"
                 Foreground="White"
                 BorderBrush="#3B82F6"
                 BorderThickness="1"
                 VerticalContentAlignment="Center"
                 IsEnabled="{Binding Search.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                 Text="{Binding Search.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 PreviewMouseLeftButtonDown="SearchTextBox_PreviewMouseLeftButtonDown"
                 GotFocus="SearchTextBox_GotFocus"
                 LostFocus="SearchTextBox_LostFocus"
                 KeyDown="SearchTextBox_KeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding Search.SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Toggle Keyboard Button -->
                <!--
                <Button
                x:Name="ToggleKeyboardButton"
                Grid.Column="1"
                Width="38" Height="38"
                Margin="8,0,0,0"
                Click="ToggleKeyboard_Click"
                ToolTip="Tampilkan Keyboard">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderBrush" Value="#3B82F6" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Content" Value="⌨" />
                        </Style>
                    </Button.Style>
                </Button>
                -->

                <!-- Voice Search Button -->
                <Grid Grid.Column="2" Margin="8,0,0,0">
                    <Button Width="38"
                    Height="38"
                    Command="{Binding Search.SearchByVoiceCommand}"
                    Visibility="{Binding Search.IsVoiceSearchEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="Cari dengan Suara">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="ButtonRoot" Background="Transparent">
                                                <Ellipse x:Name="PulseRing"
                                                 Fill="#EF4444"
                                                 Opacity="0"
                                                 RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>

                                                <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="19">
                                                    <TextBlock x:Name="IconText"
                                                       Text="🎤"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Search.IsListening}" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#DC2626" />
                                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#EF4444" />
                                                    <Setter Property="ToolTip" Value="Mendengarkan..." />

                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="RecordingPulseStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         From="1.0" To="1.7"
                                                                         Duration="0:0:1.2" />
                                                                <DoubleAnimation Storyboard.TargetName="PulseScale"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         From="1.0" To="1.7"
                                                                         Duration="0:0:1.2" />
                                                                <DoubleAnimation Storyboard.TargetName="PulseRing"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0.8" To="0.0"
                                                                         Duration="0:0:1.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>

                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="RecordingPulseStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>

                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Cari Button -->
                <Button Grid.Column="3"
                Margin="8,0,0,0"
                Height="38"
                Command="{Binding Search.SearchCommand}"
                Click="CariButton_Click"
                        >
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563EB" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="#2563EB" CornerRadius="6">
                                            <TextBlock x:Name="BtnText"
                                               Text="Cari"
                                               Padding="16,0"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1D4ED8" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Search.IsBusy}" Value="True">
                                                <Setter TargetName="BtnText" Property="Text" Value="Mencari..." />
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseTextStoryboard">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetName="BtnText"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.3" Duration="0:0:0.6" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseTextStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Popup Keyboard -->
                <Popup x:Name="KeyboardPopup"
               PlacementTarget="{Binding ElementName=SearchTextBox}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True">
                    <Border Background="#0F172A"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,4,0,0">
                        <controls:OnScreenKeyboard InputText="{Binding Search.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>

        <!-- Session Info -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,20,0">

            <!-- Remaining Time -->
            <Border Margin="0,0,10,0"
                    Padding="12,6"
                    CornerRadius="12"
                    Background="#1E293B"
                    BorderBrush="#1E3A8A"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FFFACC15"
                           Text="{Binding Player.RemainingTimeText, FallbackValue=00:00, TargetNullValue=00:00}"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Session Status -->
            <Border Padding="12,6"
                    CornerRadius="12"
                    Background="#1E293B"
                    BorderBrush="#1E3A8A"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10"
                             Height="10"
                             VerticalAlignment="Center"
                             Fill="{Binding Player.IsSessionActive, Converter={StaticResource StatusBrushConverter}}" />

                    <TextBlock Margin="8,0,0,0"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="White"
                               Text="{Binding Player.IsSessionActive, Converter={StaticResource StatusTextConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
