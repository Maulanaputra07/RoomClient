<UserControl x:Class="RoomClient.Views.SongList.SongListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RoomClient.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="White" Text="Song List" />
                <TextBlock FontSize="12" Foreground="#FF94A3B8" Text="Antrian lagu yang akan diputar di room." />
            </StackPanel>
            <Border DockPanel.Dock="Right" Padding="12,8" Background="#FF111827" CornerRadius="999">
                <TextBlock Foreground="#FF60A5FA" Text="{Binding Search.Results.Count, StringFormat={}{0} items}" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <!-- Pesan kalau kosong -->
            <TextBlock Text="Belum ada hasil pencarian."
                       Foreground="#FF64748B"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,20"
                       Visibility="{Binding Search.Results.Count, Converter={StaticResource CountToVisibilityConverter}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Search.Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14" Background="#FF111827" CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="64" Height="48" Background="#FF1D4ED8" CornerRadius="12" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="YT" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="#FF94A3B8" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10" Foreground="#FF64748B" Text="{Binding ViewCount, StringFormat={}{0:N0} views}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock HorizontalAlignment="Right" Foreground="#FFFBBF24" Text="{Binding DurationDisplay}" />
                                    </StackPanel>

                                    <Button Grid.Column="3"
                                            Margin="0,0,10,0"
                                            Padding="12,6"
                                            Background="#FF1E293B"
                                            Foreground="White"
                                            Content="+ Queue"
                                            Command="{Binding DataContext.SongList.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Grid.Column="4"
                                            Padding="14,6"
                                            Background="#FF2563EB"
                                            Foreground="White"
                                            Content="Play"
                                            Command="{Binding DataContext.SongList.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>