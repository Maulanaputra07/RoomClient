<UserControl x:Class="RoomClient.Views.SongList.SongListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RoomClient.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <helpers:SearchDisplayStateConverter x:Key="SearchDisplayStateConverter"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <helpers:SongTitleColorConverter x:Key="SongTitleColorConverter" />
        <helpers:PlayButtonContentConverter x:Key="PlayButtonContentConverter"/>
        
        <helpers:EmptySearchResultConverter x:Key="EmptySearchResultConverter"/>
        <helpers:SearchResultsVisibilityConverter x:Key="SearchResultsVisibilityConverter" />
        <helpers:InitialSearchStateConverter x:Key="InitialSearchStateConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="White" Text="Daftar Lagu" />
            </StackPanel>
        </DockPanel>

        <Grid x:Name="ContentGrid" Grid.Row="1">

            <!-- Initial state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                Visibility="{Binding Search.DisplayState, Converter={StaticResource SearchDisplayStateConverter}, ConverterParameter=Initial}">
                <Border Width="48" Height="48" Background="#FF1E293B" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FF64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Cari Lagu" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock FontSize="12" Foreground="#FF64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" MaxWidth="260" TextWrapping="Wrap"
                   Text="Ketik judul lagu atau nama penyanyi untuk mulai mencari." />
            </StackPanel>

            <!-- Loading state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                Visibility="{Binding Search.DisplayState, Converter={StaticResource SearchDisplayStateConverter}, ConverterParameter=Loading}">
                <Path Width="28" Height="28" Stroke="#FF2563EB" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14,2 A 12,12 0 0 1 26,14" HorizontalAlignment="Center">
                    <Path.RenderTransform>
                        <RotateTransform CenterX="14" CenterY="14" Angle="0" />
                    </Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="SpinAnimation">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinAnimation" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="Sedang melakukan pencarian..." Foreground="#FF64748B" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                Visibility="{Binding Search.DisplayState, Converter={StaticResource SearchDisplayStateConverter}, ConverterParameter=Empty}">
                <Border Width="48" Height="48" Background="#FF1E293B" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="?" FontSize="20" FontWeight="Bold" Foreground="#FF64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Lagu tidak ditemukan" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock FontSize="12" Foreground="#FF64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" MaxWidth="260" TextWrapping="Wrap">
            <Run Text="Tidak ada hasil untuk &quot;" />
            <Run Text="{Binding Search.SearchQuery, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FFCBD5E1" />
            <Run Text="&quot;. Coba kata kunci lain." />
                </TextBlock>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding Search.DisplayState, Converter={StaticResource SearchDisplayStateConverter}, ConverterParameter=HasResults}"
                          >
                <!-- Tambahkan HorizontalContentAlignment="Stretch" di sini -->
                <ItemsControl ItemsSource="{Binding Search.Results}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14" Background="#FF111827" CornerRadius="14" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0" Grid.Column="0" Width="24" Height="24" Background="#FF1D4ED8" CornerRadius="10" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="YT" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Judul & Durasi -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="15" 
                                                    FontWeight="SemiBold" 
                                                    TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <Binding Path="Title" />
                                            </TextBlock.Text>
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource SongTitleColorConverter}">
                                                    <Binding Path="VideoId" />
                                                    <Binding Path="DataContext.Player.CurrentSong.VideoId"
                                                        RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>

                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#FFFBBF24" 
                                                   Text="{Binding DurationDisplay}" />
                                    </StackPanel>

                                    <!-- Baris Tombol Action -->
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Paksa Stretch pada Button & Center pada Konten Teksnya -->
                                        <Button Grid.Column="0"
                                                Padding="0,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="#FF1E293B"
                                                Foreground="White"
                                                Content="+ Antrian"
                                                Command="{Binding DataContext.SongList.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />

                                        <Button Grid.Column="2"
                                            Padding="0,8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="#FF2563EB"
                                            Foreground="White"
                                            Command="{Binding DataContext.SongList.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                            <Button.Content>
                                                <MultiBinding Converter="{StaticResource PlayButtonContentConverter}">
                                                    <Binding Path="VideoId" />
                                                    <Binding Path="DataContext.Player.CurrentSong.VideoId"
                                                        RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    <Binding Path="DataContext.Player.IsPlaying"
                                                        RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
