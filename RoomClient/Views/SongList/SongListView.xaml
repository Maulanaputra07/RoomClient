<UserControl x:Class="RoomClient.Views.SongList.SongListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RoomClient.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="White" Text="Daftar Lagu" />
            </StackPanel>
        </DockPanel>

        <Grid x:Name="ContentGrid" Grid.Row="1">
            <TextBlock Text="Belum ada hasil pencarian."
                       Foreground="#FF64748B"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,20"
                       Visibility="{Binding Search.Results.Count, Converter={StaticResource CountToVisibilityConverter}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Tambahkan HorizontalContentAlignment="Stretch" di sini -->
                <ItemsControl ItemsSource="{Binding Search.Results}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="14" Background="#FF111827" CornerRadius="14" HorizontalAlignment="Stretch">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Row="0" Grid.Column="0" Width="24" Height="24" Background="#FF1D4ED8" CornerRadius="10" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="YT" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Judul & Durasi -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="15" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="White" 
                                                   Text="{Binding Title}" 
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#FFFBBF24" 
                                                   Text="{Binding DurationDisplay}" />
                                    </StackPanel>

                                    <!-- Baris Tombol Action -->
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Paksa Stretch pada Button & Center pada Konten Teksnya -->
                                        <Button Grid.Column="0"
                                                Padding="0,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="#FF1E293B"
                                                Foreground="White"
                                                Content="+ Antrian"
                                                Command="{Binding DataContext.SongList.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />

                                        <Button Grid.Column="2"
                                                Padding="0,8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="#FF2563EB"
                                                Foreground="White"
                                                Content="Play"
                                                Command="{Binding DataContext.SongList.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>