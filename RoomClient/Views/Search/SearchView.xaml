<UserControl x:Class="RoomClient.Views.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="220"
             d:DesignWidth="520">
    <StackPanel Margin="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="White" Text="Search" />
        <TextBlock Margin="0,4,0,10" FontSize="12" Foreground="#FF94A3B8" Text="Test lokal cari lagu lalu mainkan di WebView2." />

        <!-- Input Group: Text & Voice -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="34"
                     Padding="12,6"
                     Background="#FF111827"
                     Foreground="White"
                     BorderBrush="#FF334155"
                     Text="{Binding Search.SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding Search.SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <!-- Voice Search Button pinned to the input -->
            <Button Grid.Column="1" 
                    Margin="8,0,0,0"
                    Width="34" 
                    Height="34"
                    Background="#FF111827" 
                    Foreground="White"
                    BorderBrush="#FF334155"
                    Content="🎤" 
                    ToolTip="Search by Voice"
                    Command="{Binding Search.SearchByVoiceCommand}" />
        </Grid>

        <!-- Secondary Actions -->
        <WrapPanel>
            <Button Margin="0,0,8,8" Padding="12,6" Background="#FF111827" Foreground="White" Content="Search" Command="{Binding Search.SearchCommand}" />
            <Button Margin="0,0,8,8" Padding="12,6" Background="#FF7C3AED" Foreground="White" Content="Test Fullscreen" Command="{Binding Search.ToggleFullScreenCommand}" />
        </WrapPanel>

        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#FF94A3B8" Text="{Binding Search.StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>